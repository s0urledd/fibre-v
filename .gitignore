# build output
/bin/
**/bin/
*.exe
*.test
*.out
coverage.txt

# local Go workspace (use for cross-module dev; not committed)
go.work
go.work.sum

# editor / OS
.idea/
.vscode/
.DS_Store

# runtime data the tools write (only sample/ is committed, by exception)
sentinel-data/
*.jsonl
!fibre-sentinel/sample/**/*.jsonl

# observer test fixture (one consistent devnet run); the sentinel data-dir patterns above must not hide it
!fibre-sentinel/observer/testdata/*.jsonl
!fibre-sentinel/observer/testdata/state.json

# python bytecode from the web fixture
__pycache__/
*.pyc

# promises sentinel-pub -abandon writes, by default into the directory it was
# run from. Two of them from a devnet run left the working tree dirty on the
# live vantage, and Go stamps that into every binary built there: the build
# revision goes onto every probe row and into runs.jsonl, so a "-dirty" build
# is a published row nobody can tie back to a commit.
abandoned-*.json

# stray binaries from "go build ./cmd/<name>/" run at the module root
fibre-sentinel/observer-api
fibre-sentinel/observer-collector
fibre-sentinel/observer-heartbeat
fibre-sentinel/sentinel-*
