[Unit]
Description=Fibre observer: read-only JSON API
After=network-online.target
Wants=network-online.target

[Service]
User=fibre-observer
EnvironmentFile=/etc/fibre-observer/observer.env
ExecStart=/usr/local/bin/observer-api -data-dir ${DATA_DIR} -listen ${API_LISTEN} -vantage ${VANTAGE} \
  -vantage-location ${VANTAGE_LOCATION} -vantage-provider ${VANTAGE_PROVIDER} \
  -vantage-asn ${VANTAGE_ASN} -vantage-egress ${VANTAGE_EGRESS} \
  -publishers /etc/fibre-observer/publishers.yaml
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# only the data directory, not the service user's whole home
ReadWritePaths=/var/lib/fibre-observer/data

[Install]
WantedBy=multi-user.target
