[Unit]
Description=Fibre observer: chain scanner (sentinel-scan)
After=network-online.target
Wants=network-online.target

[Service]
User=fibre-observer
EnvironmentFile=/etc/fibre-observer/observer.env
ExecStart=/usr/local/bin/sentinel-scan -rpc ${RPC} -data-dir ${DATA_DIR} -start-height ${START_HEIGHT} -follow -follow-timeout 10m
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# only the data directory, not the service user's whole home
ReadWritePaths=/var/lib/fibre-observer/data

[Install]
WantedBy=multi-user.target
