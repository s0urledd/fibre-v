[Unit]
Description=Fibre observer: endpoint reachability heartbeat
After=network-online.target
Wants=network-online.target

[Service]
User=fibre-observer
EnvironmentFile=/etc/fibre-observer/observer.env
ExecStart=/usr/local/bin/observer-heartbeat -rpc ${RPC} -data-dir ${DATA_DIR} -vantage ${VANTAGE} -interval 10m
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/fibre-observer

[Install]
WantedBy=multi-user.target
