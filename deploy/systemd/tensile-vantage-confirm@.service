[Unit]
Description=Tensile second vantage (%i): confirm the observer's retention faults
After=network-online.target
Wants=network-online.target

# Runs on the second vantage's host, not the observer (deploy/README.md,
# "Second vantage: fault confirmation"). The instance is the vantage name.
# It reads the requests the observer's sftp account drops in the inbox, asks
# each failed validator for the same rows once, and appends the answers to
# measurements.jsonl in its own data dir, which the observer pulls back.
# Outbound only: a Mocha RPC for the validator set, and the validators'
# Fibre endpoints.

[Service]
User=tensile-vantage
Group=tensile-vantage
# 0640 files: the sftp account reads measurements.jsonl through the group
UMask=0027
Environment=RPC=https://celestia-testnet-rpc.polkachu.com:443
ExecStart=/usr/local/bin/tensile-probe -confirm-requests /srv/tensile-vantage/%i/inbox/requests.jsonl -data-dir /srv/tensile-vantage/%i -vantage %i -rpc ${RPC}
Restart=always
RestartSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# its own data dir only; the inbox inside it is the observer's to write
ReadWritePaths=/srv/tensile-vantage/%i
ReadOnlyPaths=-/srv/tensile-vantage/%i/inbox

[Install]
WantedBy=multi-user.target
# one instance per vantage: systemctl enable --now tensile-vantage-confirm@de-1
