# /etc/fibre-observer/observer.env — one line per setting, no quotes needed.
# your own full node with storage.discard_abci_responses = false (public RPCs
# discard block_results). Under docker compose this must be an address the
# containers can reach, not 127.0.0.1.
RPC=http://127.0.0.1:26657
VANTAGE=eu1
DATA_DIR=/var/lib/fibre-observer/data
# systemd: the file you copied in step 3. docker compose: one of the two files
# baked into the image, /etc/fibre-observer/policy.mocha.yaml or policy.example.yaml
POLICY=/etc/fibre-observer/policy.yaml
API_LISTEN=127.0.0.1:8080

# Where this vantage watches from. Every reachability verdict on the site is a
# statement about a network path and half that path is yours, so a reader
# cannot judge an "unreachable" without these. The About page points at
# /v1/meta for them; leave them blank and the API logs a warning at startup
# and the dashboard says the vantage is undescribed.
#
# The first three are your claim and nothing proves them. VANTAGE_EGRESS is
# the verifiable part: a validator operator who sees connections from these
# addresses on their Fibre port can match them against this record, and one
# who sees connections from anywhere else knows they are not you. Find yours
# with `curl -4 ifconfig.co` and `curl -6 ifconfig.co` from the host, and
# include every address the machine can leave from.
VANTAGE_LOCATION=Helsinki, Finland
VANTAGE_PROVIDER=Hetzner
VANTAGE_ASN=AS24940
VANTAGE_EGRESS=203.0.113.10,2001:db8::10
# scanner: height to start from on a fresh data dir (0 = chain tip at first start)
START_HEIGHT=0
# docker compose only
DOMAIN=observer.example.org
